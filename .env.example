# Copy to .env and fill in real values. Never commit .env.
# Comments sit on their own lines on purpose: some env parsers keep inline "# ..." as part of the value.

# At least two keys, comma-separated. For Gemini, create each key in a DIFFERENT Google Cloud
# project: rate limits are per project, so two keys from one project share a single quota.
LLM_API_KEYS=your_key_1,your_key_2
# LiteLLM model string, provider prefix included (this exact string is returned as metadata.model).
LLM_MODEL=gemini/gemini-3.5-flash
# Optional. Leave empty for the provider default. Tests and the fake server set it.
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# SQLite file. Four slashes = absolute path (/data is the Docker volume), three = relative.
DATABASE_URL=sqlite:////data/app.db

# Exact browser origins allowed by CORS, comma-separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Honour the X-Simulate-Failure test header. Keep true for the demo and grading.
ENABLE_FAILURE_SIMULATION=true

DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# How many stored messages (user + assistant) are sent back to the model as context.
HISTORY_MAX_MESSAGES=40

# local = in-process memory | disk = SQLite file under CACHE_DIR (survives restarts)
CACHE_TYPE=local
CACHE_DIR=/data/litellm_cache

LOG_LEVEL=INFO

# Frontend build-time setting: the backend URL the browser calls (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000
